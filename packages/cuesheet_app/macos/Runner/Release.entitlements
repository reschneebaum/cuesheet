<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outbound HTTP, for feed refresh and directory search. The sandbox
	     denies it by default and Flutter's template does not add it, so
	     without this every fetch fails with a socket error that looks like
	     the feed is down rather than like the app is boxed in. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
